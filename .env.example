# Shared secret between the extension and the inbox server.
# Make one with: openssl rand -hex 32
# Store it in 1Password and refer to it as op://<vault>/<item>/<field>.
INBOX_TOKEN=op://<vault>/<item>/INBOX_TOKEN
INBOX_PORT=4319
# Comma-separated chat names of the personal WhatsApp account. The business
# account forwards every chat. Empty forwards no personal chat.
WHATSAPP_PERSONAL_CHATS=
GITHUB_POLL_SECONDS=60
# Comma-separated Gmail accounts that the inbox server polls. The OAuth files
# of the google MCP in ~/.google_workspace_mcp/credentials give the access.
# Empty polls no account.
GMAIL_ACCOUNTS=
GMAIL_POLL_SECONDS=60
# Comma-separated absolute paths of the checkouts that the inbox server keeps
# in sync with origin. Empty syncs no checkout.
CHECKOUT_SYNC_PATHS=
CHECKOUT_SYNC_MINUTES=5
# The named Cloudflare tunnel that `pnpm assistant start` runs in the
# services window. Empty runs no tunnel.
CLOUDFLARE_TUNNEL=
# MCP settings. scripts/with-secrets.sh resolves the op:// references, and
# .mcp.json reads these values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=op://<vault>/<item>/GOOGLE_OAUTH_CLIENT_SECRET
# ElevenLabs Scribe transcribes the conversation recordings (pnpm audio:*).
ELEVENLABS_API_KEY=op://<vault>/<item>/ELEVENLABS_API_KEY
# The microphone of the recorder, by its avfoundation name. List the names
# with: ffmpeg -f avfoundation -list_devices true -i ""
AUDIO_INPUT_DEVICE=MacBook Pro Microphone
