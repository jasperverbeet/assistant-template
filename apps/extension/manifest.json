{
  "manifest_version": 3,
  "name": "Assistant Inbox",
  "version": "0.0.1",
  "description": "Forwards new WhatsApp Web messages to the local assistant inbox.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://web.whatsapp.com/*"]
}
