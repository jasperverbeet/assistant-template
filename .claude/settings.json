{
  "permissions": {
    "additionalDirectories": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 30,
            "statusMessage": "Starting assistant services"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
